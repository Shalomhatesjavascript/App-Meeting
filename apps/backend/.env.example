# Drizzle CLI (d1-http driver) credentials.
# Used by `bun run db:*` commands from drizzle.config.ts.
CLOUDFLARE_ACCOUNT_ID=get from https://orm.drizzle.team/docs/guides/d1-http-with-drizzle-kit
CLOUDFLARE_DATABASE_ID=get from https://orm.drizzle.team/docs/guides/d1-http-with-drizzle-kit
CLOUDFLARE_D1_TOKEN=get from https://orm.drizzle.team/docs/guides/d1-http-with-drizzle-kit

# App runtime database access does NOT come from .env.
# It comes from wrangler.jsonc d1_databases binding: env.DB.
# `wrangler dev` uses a local D1 file by default.
# Use `wrangler dev --remote` when you want the same remote DB data in development.
