{
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.5.6",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.5.6",
    "better-ts-enum": "^0.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "latest",
    "neverthrow": "^8.2.0",
    "valibot": "^1.3.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.75.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "module": "src/index.ts",
  "name": "@repo/backend",
  "scripts": {
    "build": "bun build --outdir=dist --minify-whitespace --minify-syntax --minify-identifiers src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:local:reset": "rm -rf .wrangler/state/v3/d1 && bunx wrangler d1 migrations apply social-media-babcock-test-db --local && bunx wrangler d1 execute social-media-babcock-test-db --local --file scripts/seed.sql",
    "db:local:seed": "bunx wrangler d1 execute social-media-babcock-test-db --local --file scripts/seed.sql",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio --port 3131",
    "dev": "wrangler dev",
    "format": "biome format ./ --write",
    "gen:types": "wrangler types",
    "lint": "biome lint ./ --write",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "version": "1.0.50"
}
