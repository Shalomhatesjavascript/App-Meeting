{
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@elysiajs/cors": "^1.4.2",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.6.11",
    "better-ts-enum": "^0.6.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-valibot": "^0.4.2",
    "elysia": "^1.4.28",
    "neverthrow": "^8.2.0",
    "resend": "^6.12.3",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.92.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "module": "src/index.ts",
  "name": "@repo/backend",
  "scripts": {
    "auth:gen": "bunx auth generate --config ./src/utils/auth.ts --output ./src/utils/auth/schema.ts -y",
    "build": "bun build --outdir=dist --minify-whitespace --minify-syntax --minify-identifiers src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply social-media-babcock-test-db --local",
    "db:push": "bunx drizzle-kit push",
    "db:reset:local": "rm -rf .wrangler/state && bun db:migrate:local",
    "db:studio": "bunx drizzle-kit studio --port 3131",
    "dev": "wrangler dev",
    "format": "biome format ./ --write",
    "gen:types": "wrangler types",
    "lint": "biome lint ./ --write",
    "onboard": "bun run db:reset:local",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "version": "1.0.50"
}