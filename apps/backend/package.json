{
  "name": "@repo/backend",
  "version": "1.0.50",
  "scripts": {
    "dev": "wrangler dev",
    "build": "bun build --outdir=dist --minify-whitespace --minify-syntax --minify-identifiers src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint ./ --write",
    "format": "biome format ./ --write",
    "test": "bun test"
  },
  "dependencies": {
    "elysia": "latest",
    "@repo/shared": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "module": "src/index.ts"
}
